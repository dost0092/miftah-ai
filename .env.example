# Public site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://miftahai.co

# Supabase. If you connected Supabase through the Vercel integration, these are
# created for you automatically (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ...).
# Locally: `vercel env pull .env.local`
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only key used by API routes to write waitlist / contact rows. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Claude API key for the AI advisor's written answers. Without it the advisor
# answers by quoting the official library directly.
ANTHROPIC_API_KEY=

# Optional: OpenRouter keys for written answers (used when ANTHROPIC_API_KEY is empty).
# Add one or more keys; when one hits its daily limit or fails, the next one is used.
# You can also put several in OPENROUTER_API_KEYS, separated by commas.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
# Defaults: google/gemma-4-31b-it:free, then google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# Optional: map tiles for the workspace map (defaults to OpenStreetMap's public tiles,
# which are fine for development; use a commercial provider for production traffic).
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Local only: open the workspace without signing in (never active in production builds).
# APP_DEV_PREVIEW=1

# ── Billing (Paddle, merchant of record) ──
# "sandbox" for testing, "production" when live.
PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication → client-side token (test_… / live_…).
PADDLE_CLIENT_TOKEN=
# Price id of "Miftah AI Pro" (pri_…): US$26.40 monthly (= SAR 99; Paddle has no SAR).
PADDLE_PRICE_ID=
# Paddle → Developer tools → Authentication → API key (server only; opens the customer portal).
PADDLE_API_KEY=
# Paddle → Developer tools → Notifications → destination https://miftahai.co/api/billing/webhook → secret key.
PADDLE_WEBHOOK_SECRET=
